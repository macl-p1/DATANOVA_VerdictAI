import os
import re
import torch
import numpy as np
import pandas as pd
import gradio as gr
from datetime import datetime
from typing import List, Optional, Dict
from pydantic import BaseModel, Field

import evaluate
from datasets import Dataset
from transformers import (
    AutoTokenizer,
    AutoModelForTokenClassification,
    TrainingArguments,
    Trainer,
    DataCollatorForTokenClassification,
    pipeline
)

# Verify compute environment
device = "cuda" if torch.cuda.is_available() else "cpu"
print(f"--- VerdictAI Pipeline Initialized on Device: {device} ---")

# ==============================================================================
# 2. SCHEMAS & CONFIGURATION
# ==============================================================================
MODEL_CHECKPOINT = "google/muril-base-cased"  # Indic & Indian English optimized Transformer

LABEL_LIST = [
    "O",
    "B-ARREST_DATE", "I-ARREST_DATE",
    "B-LEGAL_SECTION", "I-LEGAL_SECTION",
    "B-OFFENCE", "I-OFFENCE",
    "B-CUSTODY_STATUS", "I-CUSTODY_STATUS"
]

label2id = {label: i for i, label in enumerate(LABEL_LIST)}
id2label = {i: label for i, label in enumerate(LABEL_LIST)}

# Pydantic Schemas for Structured Facts & Verdicts
class ExtractedEntity(BaseModel):
    type: str
    value: str
    normalized_value: Optional[str] = None
    confidence: float

class StatutoryPenalty(BaseModel):
    section: str
    offence_description: str
    max_sentence_years: float
    is_bailable: bool
    statute_source: str

class CustodyMetrics(BaseModel):
    arrest_date: Optional[str] = None
    days_in_custody: Optional[int] = None
    half_sentence_days: Optional[float] = None
    max_sentence_days: Optional[float] = None

class VerdictResult(BaseModel):
    verdict_flag: str
    sections_applied: List[StatutoryPenalty]
    custody_summary: CustodyMetrics
    review_reasons: List[str] = []
    verdict_summary: str
    extracted_facts: List[ExtractedEntity]

# ==============================================================================
# 3. TRAINING DATASET & SUBWORD TOKEN ALIGNMENT
# ==============================================================================
def create_dataset():
    data = [
        {
            "tokens": ["The", "accused", "was", "arrested", "on", "15", "January", "2023", "and", "remanded", "to", "judicial", "custody", "."],
            "ner_tags": [label2id[t] for t in ["O", "O", "O", "O", "O", "B-ARREST_DATE", "I-ARREST_DATE", "I-ARREST_DATE", "O", "O", "O", "B-CUSTODY_STATUS", "I-CUSTODY_STATUS", "O"]]
        },
        {
            "tokens": ["He", "was", "charged", "under", "Section", "303", "BNS", "for", "committing", "theft", "."],
            "ner_tags": [label2id[t] for t in ["O", "O", "O", "O", "B-LEGAL_SECTION", "I-LEGAL_SECTION", "I-LEGAL_SECTION", "O", "O", "B-OFFENCE", "O"]]
        },
        {
            "tokens": ["The", "police", "took", "him", "into", "custody", "on", "10-08-2022", "under", "Section", "379", "IPC", "."],
            "ner_tags": [label2id[t] for t in ["O", "O", "O", "O", "B-CUSTODY_STATUS", "I-CUSTODY_STATUS", "O", "B-ARREST_DATE", "O", "B-LEGAL_SECTION", "I-LEGAL_SECTION", "I-LEGAL_SECTION", "O"]]
        },
        {
            "tokens": ["Accused", "A1", "was", "taken", "into", "custody", "on", "01/05/2021", "for", "murder", "under", "Section", "302", "IPC", "."],
            "ner_tags": [label2id[t] for t in ["O", "O", "O", "B-CUSTODY_STATUS", "I-CUSTODY_STATUS", "I-CUSTODY_STATUS", "O", "B-ARREST_DATE", "O", "B-OFFENCE", "O", "B-LEGAL_SECTION", "I-LEGAL_SECTION", "I-LEGAL_SECTION", "O"]]
        },
        {
            "tokens": ["The", "petitioner", "remains", "in", "judicial", "custody", "since", "20", "March", "2022", "under", "Sec", "303", "BNS", "."],
            "ner_tags": [label2id[t] for t in ["O", "O", "O", "B-CUSTODY_STATUS", "I-CUSTODY_STATUS", "I-CUSTODY_STATUS", "O", "B-ARREST_DATE", "I-ARREST_DATE", "I-ARREST_DATE", "O", "B-LEGAL_SECTION", "I-LEGAL_SECTION", "I-LEGAL_SECTION", "O"]]
        }
    ]
    return data * 40

raw_dataset = Dataset.from_dict({
    "tokens": [s["tokens"] for s in create_dataset()],
    "ner_tags": [s["ner_tags"] for s in create_dataset()]
})

splits = raw_dataset.train_test_split(test_size=0.2)
tokenizer = AutoTokenizer.from_pretrained(MODEL_CHECKPOINT)

def tokenize_and_align_labels(examples):
    tokenized_inputs = tokenizer(
        examples["tokens"],
        truncation=True,
        is_split_into_words=True,
        max_length=128,
        padding="max_length"
    )

    labels = []
    for i, label in enumerate(examples["ner_tags"]):
        word_ids = tokenized_inputs.word_ids(batch_index=i)
        previous_word_idx = None
        label_ids = []
        for word_idx in word_ids:
            if word_idx is None:
                label_ids.append(-100)
            elif word_idx != previous_word_idx:
                label_ids.append(label[word_idx])
            else:
                label_ids.append(-100)
            previous_word_idx = word_idx
        labels.append(label_ids)

    tokenized_inputs["labels"] = labels
    return tokenized_inputs

encoded_train = splits["train"].map(tokenize_and_align_labels, batched=True)
encoded_val = splits["test"].map(tokenize_and_align_labels, batched=True)

# ==============================================================================
# 4. TRANSFORMER FINE-TUNING
# ==============================================================================
model = AutoModelForTokenClassification.from_pretrained(
    MODEL_CHECKPOINT,
    num_labels=len(LABEL_LIST),
    id2label=id2label,
    label2id=label2id
)

seqeval_metric = evaluate.load("seqeval")

def compute_metrics(p):
    predictions, labels = p
    predictions = np.argmax(predictions, axis=2)

    true_predictions = [
        [LABEL_LIST[p] for (p, l) in zip(prediction, label) if l != -100]
        for prediction, label in zip(predictions, labels)
    ]
    true_labels = [
        [LABEL_LIST[l] for (p, l) in zip(prediction, label) if l != -100]
        for prediction, label in zip(predictions, labels)
    ]

    results = seqeval_metric.compute(predictions=true_predictions, references=true_labels)
    return {
        "precision": results["overall_precision"],
        "recall": results["overall_recall"],
        "f1": results["overall_f1"],
        "accuracy": results["overall_accuracy"],
    }

output_dir = "./artifacts/verdictai-ner-model"

# Compatible Arguments Setup
training_args = TrainingArguments(
    output_dir=output_dir,
    eval_strategy="epoch",
    save_strategy="epoch",
    learning_rate=3e-5,
    per_device_train_batch_size=8,
    per_device_eval_batch_size=8,
    num_train_epochs=5,
    weight_decay=0.01,
    logging_steps=10,
    save_total_limit=1,
    load_best_model_at_end=True,
    metric_for_best_model="f1",
    report_to="none"
)

# Setup Trainer handling parameter deprecations across versions
try:
    trainer = Trainer(
        model=model,
        args=training_args,
        train_dataset=encoded_train,
        eval_dataset=encoded_val,
        processing_class=tokenizer,
        data_collator=DataCollatorForTokenClassification(tokenizer),
        compute_metrics=compute_metrics
    )
except TypeError:
    # Fallback for legacy HF versions
    trainer = Trainer(
        model=model,
        args=training_args,
        train_dataset=encoded_train,
        eval_dataset=encoded_val,
        tokenizer=tokenizer,
        data_collator=DataCollatorForTokenClassification(tokenizer),
        compute_metrics=compute_metrics
    )

print("\n>>> STARTING MODEL TRAINING <<<")
trainer.train()
print(">>> TRAINING COMPLETE. SAVING WEIGHTS <<<")

trainer.save_model(output_dir)
tokenizer.save_pretrained(output_dir)

# ==============================================================================
# 5. INFERENCE PIPELINE & ENTITY POST-PROCESSING
# ==============================================================================
ner_pipeline = pipeline(
    "token-classification",
    model=output_dir,
    tokenizer=output_dir,
    aggregation_strategy="simple",
    device=0 if device == "cuda" else -1
)

def run_ai_extraction(text: str) -> List[ExtractedEntity]:
    predictions = ner_pipeline(text)
    extracted_entities = []

    for pred in predictions:
        group = pred.get("entity_group")
        word = pred.get("word").strip().replace("##", "")
        score = float(pred.get("score"))

        if group == "O":
            continue

        norm_val = word
        if group == "ARREST_DATE":
            date_match = re.search(r'\d{1,2}[\s\-\/\.]\w+[\s\-\/\.]\d{4}|\d{4}-\d{2}-\d{2}|\d{1,2}[\.\/]\d{1,2}[\.\/]\d{4}', word)
            if date_match:
                raw_d = date_match.group(0)
                for fmt in ("%d %B %Y", "%d-%m-%Y", "%d/%m/%Y", "%Y-%m-%d"):
                    try:
                        norm_val = datetime.strptime(raw_d, fmt).strftime("%Y-%m-%d")
                        break
                    except ValueError:
                        pass

        if group == "LEGAL_SECTION":
            if "303" in word or "BNS" in word:
                norm_val = "BNS_303"
            elif "302" in word or "IPC" in word:
                norm_val = "IPC_302"
            elif "379" in word:
                norm_val = "IPC_379"

        extracted_entities.append(ExtractedEntity(
            type=group,
            value=word,
            normalized_value=norm_val,
            confidence=round(score, 4)
        ))

    return extracted_entities

# ==============================================================================
# 6. DETERMINISTIC LEGAL RULE ENGINE
# ==============================================================================
STATUTE_DB: Dict[str, Dict] = {
    "BNS_303": {
        "section": "Section 303 BNS",
        "offence_description": "Theft",
        "max_sentence_years": 3.0,
        "is_bailable": True,
        "statute_source": "Bharatiya Nyaya Sanhita 2023"
    },
    "IPC_302": {
        "section": "Section 302 IPC",
        "offence_description": "Murder",
        "max_sentence_years": 99.0,
        "is_bailable": False,
        "statute_source": "Indian Penal Code 1860"
    },
    "IPC_379": {
        "section": "Section 379 IPC",
        "offence_description": "Theft (IPC)",
        "max_sentence_years": 3.0,
        "is_bailable": True,
        "statute_source": "Indian Penal Code 1860"
    }
}

def evaluate_verdict(entities: List[ExtractedEntity], reference_date: str = "2026-09-19") -> VerdictResult:
    review_reasons = []
    sections = []
    arrest_date_str = None

    for entity in entities:
        if entity.type == "LEGAL_SECTION":
            key = entity.normalized_value or ""
            if key in STATUTE_DB:
                sections.append(StatutoryPenalty(**STATUTE_DB[key]))
            else:
                review_reasons.append(f"Unmapped Legal Section extracted: {entity.value}")
        elif entity.type == "ARREST_DATE":
            arrest_date_str = entity.normalized_value

    if not arrest_date_str:
        review_reasons.append("Arrest date missing in extracted facts.")

    days_in_custody = None
    if arrest_date_str:
        try:
            arr_dt = datetime.strptime(arrest_date_str, "%Y-%m-%d")
            ref_dt = datetime.strptime(reference_date, "%Y-%m-%d")
            days_in_custody = (ref_dt - arr_dt).days
        except ValueError:
            review_reasons.append(f"Unformatted date format: {arrest_date_str}")

    max_sentence_years = max([s.max_sentence_years for s in sections], default=0.0)
    max_days = max_sentence_years * 365
    half_days = max_days / 2.0

    custody = CustodyMetrics(
        arrest_date=arrest_date_str,
        days_in_custody=days_in_custody,
        half_sentence_days=half_days,
        max_sentence_days=max_days
    )

    if review_reasons:
        flag = "NEEDS_REVIEW"
        summary = "Document requires manual review due to unmapped sections or missing details."
    elif days_in_custody and max_days > 0 and days_in_custody >= max_days:
        flag = "PAST_MAX_SENTENCE"
        summary = f"Accused served {days_in_custody} days, exceeding maximum statutory sentence of {max_sentence_years} years."
    elif days_in_custody and half_days > 0 and days_in_custody >= half_days:
        flag = "ELIGIBLE_UNDER_SECTION_479_BNS"
        summary = f"Accused served {days_in_custody} days (>= 50% of maximum). Eligible for statutory bail under Sec 479 BNS."
    else:
        flag = "UNDER_TRIAL_PENDING"
        summary = f"Accused currently in custody for {days_in_custody} days. Max statutory penalty is {max_sentence_years} years."

    return VerdictResult(
        verdict_flag=flag,
        sections_applied=sections,
        custody_summary=custody,
        review_reasons=review_reasons,
        verdict_summary=summary,
        extracted_facts=entities
    )

# ==============================================================================
# 7. GRADIO USER INTERFACE
# ==============================================================================
def process_case_ui(document_text):
    if not document_text.strip():
        return "Please input valid case OCR text.", {}

    ai_facts = run_ai_extraction(document_text)
    verdict = evaluate_verdict(ai_facts)

    flag = verdict.verdict_flag
    icon = "🚨" if flag == "PAST_MAX_SENTENCE" else "✅" if flag == "ELIGIBLE_UNDER_SECTION_479_BNS" else "⚠️" if flag == "NEEDS_REVIEW" else "ℹ️"

    markdown_out = f"""
### {icon} Case Verdict: **{flag.replace('_', ' ')}**
**Summary:** {verdict.verdict_summary}

---
#### 📊 Custody & Timeline Metrics
* **Arrest Date:** {verdict.custody_summary.arrest_date or 'Not Extracted'}
* **Days Served in Custody:** {verdict.custody_summary.days_in_custody or 0} days
* **Max Statutory Penalty:** {verdict.custody_summary.max_sentence_days or 0} days ({verdict.custody_summary.max_sentence_days/365 if verdict.custody_summary.max_sentence_days else 0:.1f} years)

#### ⚖️ Mapped Offence Penalties
"""
    for sec in verdict.sections_applied:
        markdown_out += f"* **{sec.section}** ({sec.offence_description}) — Max Sentence: {sec.max_sentence_years} yrs | Bailable: {sec.is_bailable}\n"

    if verdict.review_reasons:
        markdown_out += "\n#### 🔴 Review Reasons\n"
        for r in verdict.review_reasons:
            markdown_out += f"* {r}\n"

    return markdown_out, verdict.model_dump()

with gr.Blocks(theme=gr.themes.Soft()) as demo:
    gr.Markdown("# ⚖️ VerdictAI: Real Trained Transformer Pipeline")
    gr.Markdown("**AI Architecture Principle:** The Transformer model extracts facts $\\rightarrow$ Python rule engine determines legal verdict.")

    with gr.Row():
        with gr.Column():
            doc_input = gr.Textbox(
                lines=8,
                label="Paste Chargesheet / Court Order Text",
                value="The accused was taken into custody on 15 January 2023 and remanded to judicial custody. He is charged under Section 303 BNS for committing theft."
            )
            submit_btn = gr.Button("Analyze Case", variant="primary")

        with gr.Column():
            verdict_markdown = gr.Markdown(label="Legal Verdict")

    with gr.Accordion("🔍 AI Extracted Entities & Model Confidence Scores", open=True):
        json_debug = gr.JSON()

    submit_btn.click(fn=process_case_ui, inputs=doc_input, outputs=[verdict_markdown, json_debug])

demo.launch(share=True, debug=True)
