.env
.venv/
__pycache__/
*.py[cod]
.pytest_cache/
.coverage
dist/
build/
*.egg-info/

# Sensitive source material and generated artefacts
data/raw/*
!data/raw/.gitkeep
data/interim/*
!data/interim/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/annotations/*
!data/annotations/.gitkeep
data/training_uploads/*
!data/training_uploads/.gitkeep
!data/training_uploads/README.md
artifacts/*
!artifacts/**/.gitkeep
*.pdf
*.log

# SAM build output and local deploy state
.aws-sam/
samconfig-*.toml

# Lambda invoke dumps and scratch events kept from manual testing
backend/*-output.json
backend/*-output-*.json
backend/execution-history*.json
backend/*-test-event*.json
backend/test-*-event.json
backend/test-case-*.txt
