with gr.Blocks(theme=gr.themes.Soft(primary_hue="indigo")) as demo:
    gr.Markdown("# ⚖️ VerdictAI: Gemini 2.5 Powered Legal Case Analyzer")
    gr.Markdown("Pipeline: **Case Text $\\rightarrow$ Gemini 2.5 Flash (Structured Output Schema) $\\rightarrow$ Legal Verdict & Penal Analysis**")

    with gr.Row():
        with gr.Column(scale=1):
            api_key_box = gr.Textbox(
                label="Gemini API Key",
                placeholder="Enter key or set GEMINI_API_KEY in Colab Secrets",
                type="password"
            )
            case_text_box = gr.Textbox(
                lines=10,
                label="Paste Chargesheet / Court Order Text",
                value=sample_cases[0][0]
            )
            submit_btn = gr.Button("Analyze Case with Gemini", variant="primary")
            
            gr.Examples(
                examples=sample_cases,
                inputs=[case_text_box, api_key_box],
                label="Sample Cases"
            )

        with gr.Column(scale=1.3):
            output_markdown = gr.Markdown(label="Verdict Analysis")

    with gr.Accordion("🔍 Raw Gemini Structured JSON Response", open=False):
        json_output = gr.JSON()

    submit_btn.click(
        fn=process_case_with_gemini,
        inputs=[case_text_box, api_key_box],
        outputs=[output_markdown, json_output]
    )

# Launch Gradio interface inside Colab
demo.launch(share=True, debug=True)
