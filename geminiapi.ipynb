# ==============================================================================
# 2. DEFINE STRUCTURED OUTPUT PYDANTIC SCHEMAS
# ==============================================================================
class AppliedSection(BaseModel):
    section_number: str = Field(description="Identified section number, e.g., 'Section 303 BNS' or 'Section 302 IPC'")
    statute_name: str = Field(description="Act or code name, e.g., 'Bharatiya Nyaya Sanhita 2023' or 'Indian Penal Code 1860'")
    offence_description: str = Field(description="Summary of the offence, e.g., Theft, Murder, Grievous Hurt")
    max_punishment_years: float = Field(description="Maximum statutory sentence in years. Use 99 for Life Imprisonment or Death Penalty")
    is_bailable: bool = Field(description="True if offence is bailable, False if non-bailable")
    is_cognizable: bool = Field(description="True if cognizable offence, False if non-cognizable")

class CustodyTimeline(BaseModel):
    arrest_date: Optional[str] = Field(description="Arrest or detention date in YYYY-MM-DD format if explicitly stated in text, else null")
    days_in_custody: Optional[int] = Field(description="Calculated total days in custody from arrest date up to today (2026-09-19)")
    half_sentence_threshold_days: Optional[float] = Field(description="50% of the maximum punishment duration in days")

class LegalVerdict(BaseModel):
    verdict_status: str = Field(
        description="One of: 'ELIGIBLE_FOR_UNDER_TRIAL_BAIL', 'PAST_MAXIMUM_SENTENCE', 'UNDER_TRIAL_PENDING', 'NEEDS_HUMAN_REVIEW'"
    )
    case_summary: str = Field(description="Detailed analysis of the facts extracted from the legal text")
    applied_sections: List[AppliedSection] = Field(description="List of legal sections charged or mentioned in the case")
    custody_timeline: CustodyTimeline = Field(description="Extracted arrest date and detention calculations")
    possible_punishments: List[str] = Field(description="Detailed breakdown of potential statutory punishments per section")
    under_trial_eligibility_analysis: str = Field(description="Legal assessment under Sec 479 BNSS / Sec 436A CrPC for undertrial relief")
    missing_or_ambiguous_fields: List[str] = Field(description="Any missing critical details such as missing arrest date or missing section number")


# ==============================================================================
# 3. GEMINI API LEGAL ANALYSIS ENGINE
# ==============================================================================
SYSTEM_INSTRUCTION = """
You are VerdictAI, an expert Indian legal analysis and document extraction system.
Your job is to read legal text (chargesheets, court orders, remand applications, FIRs) and extract facts and statutory penal consequences.

Guidelines:
1. Identify all legal sections mentioned (IPC, BNS, CrPC, BNSS, NDPS, etc.).
2. Retrieve exact statutory penalties for Indian criminal law (BNS 2023 / IPC 1860).
3. Extract arrest/custody dates if present.
4. Evaluate undertrial custody duration against Section 479 BNSS / Section 436A CrPC:
   - An undertrial who has completed 1/2 (or 1/3 for first-time offenders) of the maximum statutory sentence is eligible for bail.
5. If the arrest date or sections are missing/unclear, state this explicitly in 'missing_or_ambiguous_fields' and set verdict_status to 'NEEDS_HUMAN_REVIEW'.
6. Do NOT invent or hallucinate missing dates or facts.
"""

def process_case_with_gemini(case_text: str, api_key_input: str) -> tuple[str, dict]:
    # Resolve API Key
    api_key = api_key_input.strip() if api_key_input and api_key_input.strip() else COLAB_API_KEY
    if not api_key:
        return "❌ **Error: Gemini API Key is missing.** Please provide your API key in the text box or Colab Secrets.", {}

    try:
        # Initialize Google GenAI Client
        client = genai.Client(api_key=api_key)
        
        prompt = f"""
Analyze the following case/OCR document text and provide a structured legal verdict:

--- CASE DOCUMENT TEXT ---
{case_text}
--- END DOCUMENT TEXT ---

Current Reference Date for Custody Calculation: September 19, 2026.
"""

        # Call Gemini 2.5 Flash with Pydantic Structured Output
        response = client.models.generate_content(
            model='gemini-2.5-flash',
            contents=prompt,
            config=types.GenerateContentConfig(
                system_instruction=SYSTEM_INSTRUCTION,
                response_mime_type="application/json",
                response_schema=LegalVerdict,
                temperature=0.1
            )
        )

        # Parse structured JSON response
        verdict_data = json.loads(response.text)
        verdict = LegalVerdict(**verdict_data)

        # Format Markdown output for UI
        status = verdict.verdict_status
        icon = "🚨" if status == "PAST_MAXIMUM_SENTENCE" else "✅" if status == "ELIGIBLE_FOR_UNDER_TRIAL_BAIL" else "⚠️" if status == "NEEDS_HUMAN_REVIEW" else "ℹ️"

        markdown_out = f"""
### {icon} Verdict Status: **{status.replace('_', ' ')}**

#### 📋 Case Analysis Summary
{verdict.case_summary}

---
#### ⚖️ Legal Sections & Possible Statutory Punishments
"""
        for sec in verdict.applied_sections:
            bailable_txt = "Bailable" if sec.is_bailable else "Non-Bailable"
            cognizable_txt = "Cognizable" if sec.is_cognizable else "Non-Cognizable"
            max_yrs = f"{sec.max_punishment_years} years" if sec.max_punishment_years < 90 else "Life Imprisonment / Death"
            markdown_out += f"""
* **{sec.section_number}** ({sec.statute_name})
  * **Offence:** {sec.offence_description}
  * **Max Punishment:** {max_yrs}
  * **Classification:** {bailable_txt} | {cognizable_txt}
"""

        markdown_out += f"""
---
#### 📊 Custody & Timeline
* **Extracted Arrest Date:** {verdict.custody_timeline.arrest_date or 'Not Found in Text'}
* **Days Served in Custody:** {verdict.custody_timeline.days_in_custody or 0} days
* **50% Sentence Threshold:** {verdict.custody_timeline.half_sentence_threshold_days or 0} days

---
#### ⚖️ Undertrial Relief Analysis (Sec 479 BNSS / Sec 436A CrPC)
{verdict.under_trial_eligibility_analysis}

#### 📜 Detailed Penal Breakdown
"""
        for punishment in verdict.possible_punishments:
            markdown_out += f"* {punishment}\n"

        if verdict.missing_or_ambiguous_fields:
            markdown_out += "\n#### 🔴 Missing / Ambiguous Information Needed for Review\n"
            for missing in verdict.missing_or_ambiguous_fields:
                markdown_out += f"* {missing}\n"

        return markdown_out, verdict.model_dump()

    except Exception as e:
        return f"❌ **Error executing Gemini API:** {str(e)}", {}

